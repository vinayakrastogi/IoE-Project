# Optional. Leave unset to auto-detect the backend at the same hostname the
# frontend was loaded from, on port 8000 - this is what lets you open the
# app from a phone on the same WiFi (http://<lan-ip>:5173) without any
# config. Only set this if your backend genuinely lives at a different
# host/port.
# VITE_API_URL=http://localhost:8000

# Same idea for the hardware lab (emulated Arduino nodes): auto-detected as
# <this host>:8090. Only set it if the lab runs somewhere else.
# VITE_LAB_URL=http://localhost:8090
